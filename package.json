{
  "name": "capri-desktop",
  "version": "0.4.3",
  "description": "Capri, the Project Capricorn construct, living on your desktop and narrating what Claude Code is doing.",
  "author": "mochiiwuff",
  "repository": "github:mochiiwuff/capri-desktop",
  "main": "src/main/main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "demo": "node scripts/demo.js",
    "hooks:install": "node scripts/install-hooks.js",
    "hooks:uninstall": "node scripts/install-hooks.js --uninstall",
    "hooks:codex:install": "node scripts/install-codex-hooks.js",
    "hooks:codex:uninstall": "node scripts/install-codex-hooks.js --uninstall",
    "hooks:agy:install": "node scripts/install-hooks-agy.js",
    "hooks:agy:uninstall": "node scripts/install-hooks-agy.js --uninstall",
    "check:llm": "node scripts/check-llm.js",
    "test:hooks": "node --test tests/hooks.test.js",
    "dist": "electron-builder --win --x64",
    "dist:32": "electron-builder --win --ia32 -c.electronVersion=43.8.3",
    "dist:all": "npm run dist && npm run dist:32",
    "test:character": "node --test tests/character.test.js",
    "test:senses": "node --test tests/senses.test.js",
    "test:bond": "node --test tests/bond.test.js",
    "test:ring": "node --test tests/ring.test.js",
    "test:claude": "node --test tests/anthropic.test.js",
    "test:config": "node --test tests/config.test.js",
    "test:chat": "node --test tests/chat.test.js",
    "test:claudecode": "node --test tests/claudecode.test.js",
    "test": "node --test tests/*.test.js"
  },
  "keywords": [
    "claude-code",
    "desktop-pet",
    "electron",
    "cyberpunk",
    "edgerunners"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "electron": "^44.9.3",
    "electron-builder": "^26.18.0"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0"
  },
  "build": {
    "appId": "capri.desktop",
    "productName": "Capri",
    "files": [
      "src/**",
      "assets/**",
      "hooks/**",
      "scripts/**",
      "package.json",
      "LICENSE",
      "!**/*.map",
      "!node_modules/@anthropic-ai/sdk/{src,bin}/**",
      "!node_modules/@anthropic-ai/sdk/**/*.{mjs,d.ts,d.mts,d.cts,md}"
    ],
    "asarUnpack": [
      "hooks/**",
      "src/main/windows.ps1",
      "src/main/media.ps1"
    ],
    "win": {
      "target": "nsis",
      "icon": "assets/icons/capri.ico"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "runAfterFinish": true,
      "createDesktopShortcut": true,
      "shortcutName": "Capri",
      "artifactName": "Capri-Setup-${version}-${arch}.${ext}"
    },
    "compression": "maximum"
  }
}
