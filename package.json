{
  "name": "capri-desktop",
  "version": "0.5.1",
  "description": "Capri, the Project Capricorn construct, living on your desktop and narrating what Claude Code is doing.",
  "author": "mochiiwuff",
  "repository": "github:mochiiwuff/capri-desktop",
  "main": "src/main/main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "demo": "node scripts/dev/demo.js",
    "hooks:install": "node scripts/hooks/install-hooks.js",
    "hooks:uninstall": "node scripts/hooks/install-hooks.js --uninstall",
    "hooks:codex:install": "node scripts/hooks/install-codex-hooks.js",
    "hooks:codex:uninstall": "node scripts/hooks/install-codex-hooks.js --uninstall",
    "hooks:agy:install": "node scripts/hooks/install-hooks-agy.js",
    "hooks:agy:uninstall": "node scripts/hooks/install-hooks-agy.js --uninstall",
    "check:llm": "node scripts/dev/check-llm.js",
    "voices:demo": "node scripts/dev/voice-demo.js",
    "check": "node selftest/selftest.js",
    "check:full": "node selftest/selftest.js --full",
    "test:hooks": "node --test tests/project/hooks.test.js",
    "test:selftest": "node --test tests/project/selftest.test.js tests/project/selftest-kit.test.js tests/project/scripts.test.js",
    "dist": "electron-builder --win --x64",
    "dist:32": "electron-builder --win --ia32 -c.electronVersion=43.8.3",
    "dist:all": "npm run dist && npm run dist:32",
    "test:character": "node --test tests/renderer/character.test.js",
    "test:senses": "node --test tests/renderer/senses.test.js",
    "test:bond": "node --test tests/renderer/bond.test.js",
    "test:ring": "node --test tests/renderer/ring.test.js",
    "test:claude": "node --test tests/main/anthropic.test.js",
    "test:config": "node --test tests/main/config.test.js",
    "test:chat": "node --test tests/renderer/chat.test.js",
    "test:claudecode": "node --test tests/main/claudecode.test.js",
    "test:release": "node --test tests/project/release.test.js",
    "test:chatterbox": "node --test tests/main/chatterbox.test.js",
    "test:ollama": "node --test tests/main/ollama-host.test.js",
    "test:provision": "node --test tests/main/provision.test.js",
    "test:stop": "node --test tests/main/stop.test.js",
    "test:downloads": "node --test tests/main/downloads.test.js",
    "test:relocate": "node --test tests/main/relocate.test.js",
    "test:progress": "node --test tests/main/progress.test.js",
    "test:prepare": "node --test tests/main/prepare.e2e.test.js",
    "test:hardware": "node --test tests/main/hardware.test.js",
    "test:profiles": "node --test tests/main/profiles.test.js",
    "test:piper": "node --test tests/main/piper.test.js",
    "test:hub": "node --test tests/main/hub.test.js",
    "test:labels": "node --test tests/project/labels.test.js",
    "test:openai": "node --test tests/main/openai.test.js",
    "test:ledges": "node --test tests/renderer/ledges.test.js",
    "test:heart": "node --test tests/renderer/heart.test.js",
    "test:acting": "node --test tests/renderer/acting.test.js",
    "test:cleanup": "node --test tests/main/cleanup.test.js",
    "test:possession": "node --test tests/renderer/possession.test.js",
    "test:mover": "node --test tests/main/mover.test.js",
    "test:node": "node --test tests/main/node-check.test.js",
    "test:stacking": "node --test tests/main/stacking.test.js",
    "test:tune": "node --test tests/main/tune.test.js",
    "test:voice-demo": "node --test tests/project/voice-demo.test.js",
    "test:voice-sample": "node --test tests/main/voice-sample.test.js",
    "test": "node scripts/dev/run-tests.js"
  },
  "keywords": [
    "claude-code",
    "desktop-pet",
    "electron",
    "cyberpunk",
    "edgerunners"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "electron": "^44.9.3",
    "electron-builder": "^26.18.0"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0"
  },
  "build": {
    "appId": "capri.desktop",
    "productName": "Capri",
    "files": [
      "src/**",
      "assets/**",
      "!assets/voice-default/**",
      "hooks/**",
      "scripts/**",
      "package.json",
      "LICENSE",
      "!**/*.map",
      "!node_modules/@anthropic-ai/sdk/{src,bin}/**",
      "!node_modules/@anthropic-ai/sdk/**/*.{mjs,d.ts,d.mts,d.cts,md}"
    ],
    "extraResources": [
      {
        "from": "src/main/voice/chatterbox-server.py",
        "to": "chatterbox-server.py"
      },
      {
        "from": "assets/voice-default",
        "to": "voice-default",
        "filter": [
          "capri.*"
        ]
      }
    ],
    "asarUnpack": [
      "hooks/**",
      "src/main/system/windows.ps1",
      "src/main/system/mover.ps1",
      "src/main/system/media.ps1"
    ],
    "win": {
      "target": "nsis",
      "icon": "assets/icons/capri.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "allowElevation": false,
      "perMachine": false,
      "multiLanguageInstaller": true,
      "installerLanguages": [
        "en_US",
        "ru_RU"
      ],
      "runAfterFinish": true,
      "include": "build/installer.nsh",
      "createDesktopShortcut": true,
      "shortcutName": "Capri",
      "artifactName": "Capri-Setup-${version}-${arch}.${ext}"
    },
    "compression": "maximum",
    "electronLanguages": [
      "en-US",
      "ru"
    ]
  }
}
